// PrivateRank Midnight Network Compact Smart Contract
// Language: Compact 0.23.0 / Ledger 8.0.2 (compactc 0.31.1)
// Privacy-Preserving Gaming Tournament Platform
//
// Architecture: Two roles — ORGANIZER and PLAYER.
// No admin. No allowlist. Any organizer wallet can create a tournament.
// The tournament's on-chain identity is the caller's Bytes<32> key.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;

export enum TournamentStatus {
  DRAFT,
  OPEN,
  CLOSED,
  COMPLETED,
  ARCHIVED
}

export struct Tournament {
  organizer: Bytes<32>,
  minRank: Uint<8>,
  minScore: Uint<32>,
  minWins: Uint<32>,
  maxParticipants: Uint<32>,
  deadline: Uint<64>,
  status: TournamentStatus,
  applicantCount: Uint<32>
}

// -------------------------------------------------------------
// LEDGER (Public State on the Midnight Blockchain)
// No admin field. No authorizedOrganizers map.
// -------------------------------------------------------------
export ledger tournaments: Map<Bytes<32>, Tournament>;
// Key: commitment of participant in tournament: hash(tournamentId, playerCommitment)
export ledger participants: Map<Bytes<32>, Boolean>;

// -------------------------------------------------------------
// CONSTRUCTOR: No admin key required.
// -------------------------------------------------------------
constructor() {
}

// -------------------------------------------------------------
// CIRCUITS
// -------------------------------------------------------------

// Create a Tournament on-chain.
// Any organizer wallet can call this circuit directly.
export circuit createTournament(
  tournamentId: Bytes<32>,
  organizerKey: Bytes<32>,
  minRank: Uint<8>,
  minScore: Uint<32>,
  minWins: Uint<32>,
  maxParticipants: Uint<32>,
  deadline: Uint<64>
): [] {
  const notExists = !tournaments.member(disclose(tournamentId));
  assert(notExists, "Tournament ID already exists");

  const newTournament = Tournament {
    organizer: disclose(organizerKey),
    minRank: disclose(minRank),
    minScore: disclose(minScore),
    minWins: disclose(minWins),
    maxParticipants: disclose(maxParticipants),
    deadline: disclose(deadline),
    status: TournamentStatus.OPEN,
    applicantCount: 0
  };

  tournaments.insert(disclose(tournamentId), newTournament);
}

// Join a Tournament as a Player.
// The playerRank, playerScore, and playerWins are private inputs (kept secret).
// The circuit verifies eligibility against on-chain requirements, prevents duplicate participation,
// verifies capacity limits, and increments applicantCount.
export circuit joinTournament(
  tournamentId: Bytes<32>,
  playerCommitment: Bytes<32>,
  playerRank: Uint<8>,
  playerScore: Uint<32>,
  playerWins: Uint<32>
): [] {
  const exists = tournaments.member(disclose(tournamentId));
  assert(exists, "Tournament does not exist");

  const tourney = tournaments.lookup(disclose(tournamentId));

  const isOpen = tourney.status == TournamentStatus.OPEN;
  assert(isOpen, "Tournament is not open for participation");

  // Organizer cannot join own tournament
  const notOrganizer = tourney.organizer != disclose(playerCommitment);
  assert(notOrganizer, "Organizer cannot participate in own tournament");

  // Capacity check
  const capacityOk = tourney.maxParticipants == 0 || tourney.applicantCount < tourney.maxParticipants;
  assert(capacityOk, "Tournament capacity reached");

  // Prevent duplicate participation by player commitment
  const participantKey = disclose(playerCommitment);
  const alreadyJoined = participants.member(participantKey);
  assert(!alreadyJoined, "Player has already joined this tournament");

  // Verify player meets minimum rank requirement (private)
  const rankOk = playerRank >= tourney.minRank;
  assert(rankOk, "Player rank does not meet minimum requirement");

  // Verify player meets minimum score requirement (private)
  const scoreOk = playerScore >= tourney.minScore;
  assert(scoreOk, "Player score does not meet minimum requirement");

  // Verify player meets minimum wins requirement (private)
  const winsOk = playerWins >= tourney.minWins;
  assert(winsOk, "Player wins do not meet minimum requirement");

  // Record participation on-chain
  participants.insert(participantKey, true);

  const updatedTourney = Tournament {
    organizer: tourney.organizer,
    minRank: tourney.minRank,
    minScore: tourney.minScore,
    minWins: tourney.minWins,
    maxParticipants: tourney.maxParticipants,
    deadline: tourney.deadline,
    status: tourney.status,
    applicantCount: (tourney.applicantCount + 1) as Uint<32>
  };

  tournaments.insert(disclose(tournamentId), updatedTourney);
}

// Close a tournament — only the owning organizer can do this.
// Transitions status from OPEN to CLOSED.
export circuit closeTournament(
  tournamentId: Bytes<32>,
  organizerKey: Bytes<32>
): [] {
  const exists = tournaments.member(disclose(tournamentId));
  assert(exists, "Tournament does not exist");

  const tourney = tournaments.lookup(disclose(tournamentId));

  const isOwner = tourney.organizer == disclose(organizerKey);
  assert(isOwner, "Caller is not the tournament organizer");

  const isOpen = tourney.status == TournamentStatus.OPEN;
  assert(isOpen, "Tournament must be OPEN to close");

  const closedTourney = Tournament {
    organizer: tourney.organizer,
    minRank: tourney.minRank,
    minScore: tourney.minScore,
    minWins: tourney.minWins,
    maxParticipants: tourney.maxParticipants,
    deadline: tourney.deadline,
    status: TournamentStatus.CLOSED,
    applicantCount: tourney.applicantCount
  };

  tournaments.insert(disclose(tournamentId), closedTourney);
}

// Archive a tournament — only the owning organizer can do this.
// Organizer can archive a CLOSED or COMPLETED tournament.
export circuit archiveTournament(
  tournamentId: Bytes<32>,
  organizerKey: Bytes<32>
): [] {
  const exists = tournaments.member(disclose(tournamentId));
  assert(exists, "Tournament does not exist");

  const tourney = tournaments.lookup(disclose(tournamentId));

  const isOwner = tourney.organizer == disclose(organizerKey);
  assert(isOwner, "Caller is not the tournament organizer");

  const completed =
    tourney.status == TournamentStatus.COMPLETED
    || tourney.status == TournamentStatus.CLOSED;
  assert(completed, "Tournament must be COMPLETED or CLOSED to archive");

  const archivedTourney = Tournament {
    organizer: tourney.organizer,
    minRank: tourney.minRank,
    minScore: tourney.minScore,
    minWins: tourney.minWins,
    maxParticipants: tourney.maxParticipants,
    deadline: tourney.deadline,
    status: TournamentStatus.ARCHIVED,
    applicantCount: tourney.applicantCount
  };

  tournaments.insert(disclose(tournamentId), archivedTourney);
}
